# AiRigBuilder Environment Variables (Set in Vercel Project Settings)
# Resend Email API Key (Free Tier - 3,000 emails/mo)
RESEND_API_KEY=re_your_resend_api_key_here

# Verified sender (airigbuilder.com is verified in Resend). Optional: this is the default.
RESEND_FROM_EMAIL=AiRigBuilder <alerts@airigbuilder.com>

# Price-alert storage: Upstash Redis (required on Vercel; serverless functions cannot write files).
# Add it from the Vercel Marketplace (Storage > Upstash Redis); it sets these two automatically.
# Copy them into a local .env too, so `npm run alerts:check` / `prices:apply` read the same alerts.
KV_REST_API_URL=https://your-db.upstash.io
KV_REST_API_TOKEN=your_upstash_rest_token

# Production application URL (used for email confirmation and unsubscribe links)
APP_URL=https://airigbuilder.com

# Affiliate Program Tracking IDs
# Amazon Associates Tracking ID (defaults to airigbuilder-20)
VITE_AMAZON_TAG=airigbuilder-20

# eBay Partner Network (EPN) Campaign ID (defaults to 5339219563)
VITE_EBAY_CAMPAIGN_ID=5339219563
